# ========================================
# Server Configuration
# ========================================
PORT=3008

# ========================================
# CORS Configuration
# ========================================
# Frontend URLs permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,https://cortex-one-hazel.vercel.app

# ========================================
# Google OAuth Configuration
# ========================================
# Obtenha estas credenciais em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# ========================================
# JWT Configuration
# ========================================
# Gere uma chave secreta forte (ex: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=3600

# ========================================
# Database Configuration (futuro)
# ========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/cortex
